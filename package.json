{
	"name": "everyintro",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "AGPL-3.0-only",
	"repository": { "type": "git", "url": "https://github.com/dmac925/everyintro.git" },
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/no-em-dash.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate:local": "wrangler d1 migrations apply everyintro --local",
		"db:migrate:remote": "wrangler d1 migrations apply everyintro --remote",
		"db:seed:local": "wrangler d1 execute everyintro --local --file=migrations/seed/job_sources.sql",
		"jobs:dev": "wrangler dev -c workers/jobs/wrangler.jsonc --persist-to .wrangler/state --test-scheduled",
		"jobs:deploy": "wrangler deploy -c workers/jobs/wrangler.jsonc",
		"check:copy": "node scripts/no-em-dash.mjs"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260911.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.131.0"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.125.0",
		"svelte-clerk": "^1.2.0",
		"zod": "^4.6.2"
	}
}
